# Never commit a real token. Copy this file to .env for local development.
# A read-enabled token can access the gated GAIA attachment fallback after you
# accept the dataset terms. The cached token from hf auth login also works.
HF_TOKEN=

# Select "gemini", "huggingface", or "ollama".
MODEL_BACKEND=gemini

# Leave blank to use lean with Gemini/Ollama and robust with Hugging Face.
# Set this explicitly to lean or robust when you want to override that default.
AGENT_PROFILE=

# Hugging Face backend. Leave the provider blank for automatic routing, or use
# a value such as groq, cheapest, or preferred.
GAIA_MODEL=openai/gpt-oss-20b
HF_INFERENCE_PROVIDER=

# Google Gemini Developer API. Keep the real key only in local .env.
# Low thinking limits reasoning usage.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Used after transient capacity or rate-limit failures. Leave blank to disable.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
# Optional dedicated model for native YouTube visual analysis; blank reuses GEMINI_MODEL.
GEMINI_VIDEO_MODEL=
GEMINI_THINKING_LEVEL=low
GEMINI_MAX_OUTPUT_TOKENS=1200

# Used only by the explicit local course-submission command. HF_AGENT_SPACE is
# the public Static Space containing this source code, without a URL prefix.
HF_USERNAME=
HF_AGENT_SPACE=

# Local Ollama backend. qwen3:8b supports tool calling; qwen3:4b is lighter but
# generally less capable. Ollama must be installed and running on this address.
OLLAMA_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://127.0.0.1:11434
# False is faster and avoids spending the response budget on hidden reasoning.
# Try true only if your machine has enough memory and the model stays reliable.
OLLAMA_REASONING=false
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_NUM_PREDICT=600

GAIA_ASR_MODEL=openai/whisper-large-v3
GAIA_API_URL=https://agents-course-unit4-scoring.hf.space
